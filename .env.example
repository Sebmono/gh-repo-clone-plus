# GitHub Personal Access Token (required)
# Get one from: https://github.com/settings/tokens
# Required scopes: repo, read:org, read:user
GITHUB_TOKEN=your_token_here

# Optional: Specify target organization (defaults to your authenticated user)
# When set to an organization, repositories are created with "internal" visibility
# When set to a personal account, repositories are created as private
# Example: TARGET_OWNER=your-org
TARGET_OWNER=your-org

# Optional: Customize target repository name (defaults to source repo name)
# TARGET_REPO=new-repo-name
